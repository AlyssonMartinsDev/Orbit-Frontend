{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:settings": "playwright test --config playwright.settings.config.mjs settings-integration.spec.mjs",
    "test:pdf": "playwright test --config playwright.settings.config.mjs pdf-integration.spec.mjs",
    "test:platform": "playwright test --config playwright.settings.config.mjs platform-integration.spec.mjs",
    "test:items": "playwright test --config playwright.settings.config.mjs items-integration.spec.mjs",
    "test:followups": "playwright test --config playwright.settings.config.mjs followups-integration.spec.mjs",
    "test:quotes": "playwright test --config playwright.settings.config.mjs quotes-integration.spec.mjs",
    "test:payments": "playwright test --config playwright.settings.config.mjs payments-integration.spec.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "axios": "^1.18.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.0",
    "tailwindcss": "^4.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.0"
  }
}
